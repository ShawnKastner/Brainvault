# Vollständiger Registry-Pfad inkl. Owner/Namespace.
# Für die GitHub-Pipeline in diesem Repo typischerweise:
# ghcr.io/<dein-github-user-oder-org>
PRIVATE_REGISTRY=ghcr.io/REPLACE_ME

# Tag, den die Pipeline gepusht hat (z. B. v1.0.0 oder sha-abc1234)
APP_IMAGE_TAG=latest

# Optional: lokales Backend-Port-Mapping
BACKEND_PORT=3001
